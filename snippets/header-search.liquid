{% comment %}
  Renders el buscador overlay animado. Reemplaza el <details-modal> nativo de
  Dawn por un custom element propio (<search-overlay>) para poder animar la
  apertura/cierre — <details> no tiene hooks de transición.

  El backend de búsqueda (fetch debounced a la Predictive Search API) sigue
  siendo el <predictive-search> original de Dawn, sin tocar — esto solo
  cambia la presentación e interacción alrededor.

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

<search-overlay class="search-overlay-wrapper">
  <button
    type="button"
    class="header__icon header__icon--search search-overlay__trigger link focus-inset"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="SearchOverlay-{{ input_id }}"
    aria-label="{{ 'general.search.search' | t }}"
  >
    <span class="svg-wrapper">
      {{- 'icon-search.svg' | inline_asset_content -}}
    </span>
  </button>

  <div
    id="SearchOverlay-{{ input_id }}"
    class="search-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'general.search.search' | t }}"
    hidden
  >
    <div class="search-overlay__backdrop"></div>
    <div class="search-overlay__panel" tabindex="-1">
      <button type="button" class="search-overlay__close" aria-label="{{ 'accessibility.close' | t }}">
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if settings.predictive_search_enabled -%}
        <predictive-search class="search-overlay__form" data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- else -%}
        <search-form class="search-overlay__form">
      {%- endif -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="search search-overlay__form-inner">
        <div class="field search-overlay__field">
          <span class="svg-wrapper search-overlay__field-icon">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </span>
          <input
            class="search__input search-overlay__input field__input"
            id="{{ input_id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="¿Qué estás buscando?..."
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
          >
          <label class="field__label visually-hidden" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
          <input type="hidden" name="options[prefix]" value="last">
          <button
            type="reset"
            class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
            aria-label="{{ 'general.search.reset' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-reset.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search search-overlay__results" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- else -%}
        </search-form>
      {%- endif -%}

      <div class="search-overlay__empty-state" data-search-empty-state>
        {%- liquid
          assign has_popular = false
          for i in (1..6)
            assign term_key = 'popular_search_' | append: i
            assign term_value = section.settings[term_key]
            if term_value != blank
              assign has_popular = true
            endif
          endfor
        -%}
        {%- if has_popular -%}
          <div class="search-overlay__section">
            <h2 class="search-overlay__section-title">Búsquedas populares</h2>
            <div class="search-overlay__pills">
              {%- for i in (1..6) -%}
                {%- assign term_key = 'popular_search_' | append: i -%}
                {%- assign term_value = section.settings[term_key] -%}
                {%- if term_value != blank -%}
                  <button type="button" class="search-overlay__pill" data-search-pill>{{ term_value }}</button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        <div class="search-overlay__section" data-recent-searches-section hidden>
          <h2 class="search-overlay__section-title">Búsquedas recientes</h2>
          <ul class="search-overlay__recent-list" data-recent-searches-list></ul>
        </div>
      </div>

      <div class="search-overlay__no-results" data-search-no-results hidden>
        <p>No encontramos resultados para "<span data-no-results-term></span>".</p>
        {%- if section.settings.search_empty_link_1 != blank or section.settings.search_empty_link_2 != blank -%}
          <div class="search-overlay__no-results-links">
            {%- if section.settings.search_empty_link_1 != blank -%}
              <a href="{{ section.settings.search_empty_link_1 }}" class="link">{{ section.settings.search_empty_link_1_label }}</a>
            {%- endif -%}
            {%- if section.settings.search_empty_link_2 != blank -%}
              <a href="{{ section.settings.search_empty_link_2 }}" class="link">{{ section.settings.search_empty_link_2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</search-overlay>
