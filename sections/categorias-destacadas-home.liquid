<section id="categorias-home">
	<div class="container">
		<div class="row">
			<div class="col-12">
            </div>
        </div>
    </div>
    <div class="full-bleed-scroller">
				<div class="cont-cont-categorias-home">
					<div class="categorias-home-cont scrollnegro-h">
						<figure class="categoria-destacada-item">
							<div class="cont-img" style="background-image: url('https://cdn.shopify.com/s/files/1/0980/1764/0757/files/44a883b7310a4a82b37fe44fe811d65f.webp?v=1784922871');"></div>
							<a href="{{ routes.root_url }}collections/botines">
								<h3>Botines</h3>
								<span class="cta"></span>
							</a>
						</figure>
						<figure class="categoria-destacada-item">
							<div class="cont-img" style="background-image: url('https://cdn.shopify.com/s/files/1/0980/1764/0757/files/Accesorios.webp?v=1784922751');"></div>
							<a href="{{ routes.root_url }}collections/accesorios">
								<h3>Accesorios</h3>
								<span class="cta"></span>
							</a>
						</figure>
						<figure class="categoria-destacada-item">
							<div class="cont-img" style="background-image: url('https://cdn.shopify.com/s/files/1/0980/1764/0757/files/Indumentaria_2_jpg.jpg?v=1784922751');"></div>
							<a href="{{ routes.root_url }}collections/indumentaria">
								<h3>Indumentaria</h3>
								<span class="cta"></span>
							</a>
						</figure>
					</div>
				</div>
				</div>

    <div class="container container-scrollbar">
		<div class="row">
			<div class="col-12">
				<div class="custom-scroll-track">
					<div class="custom-scroll-thumb"></div>
				</div>
			</div>
		</div>
	</div>
</section>

