{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{%- if page.template_suffix == 'necesitas-ayuda' -%}
  {{ 'help-page-heading.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="container">
  <div class="row">
    <div class="col-12">

      <div class="page-width page-width--narrow section-{{ section.id }}-padding">
        {%- if page.template_suffix == 'necesitas-ayuda' -%}
          <div class="help-page-heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
            <p class="help-page-heading__line help-page-heading__line--bold">Bienvenido nuevamente.</p>
            <p class="help-page-heading__line help-page-heading__line--light">¿Cómo podemos ayudarte?</p>
          </div>
        {%- else -%}
          <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
            {{ page.title | escape }}
          </h1>
        {%- endif -%}
        <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ page.content }}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
