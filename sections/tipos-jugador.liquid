<section id="tipos-jugador">
	<div class="container">
		<div class="row">
			<div class="col-md-3 col-lg-4">
				<h2>Recomendado para</h2>

				<ul class="listado-tipos-jugador">
					<li data-filter="defensores">Defensores</li>
					<li data-filter="mediocampistas">Mediocampistas</li>
					<li data-filter="delanteros" class="selected">Delanteros</li>
				</ul>

				<a href="collections/delanteros" class="button">Aplicar filtro</a>
			</div>
			<div class="col-md-9 col-lg-8">
				<div class="cont-figure">
					<figure class="cont-zapa figure-defensores" style="background-image: url('{{ 'tipo-jugador-zapa01.png' | asset_url }}');"></figure>
					<figure class="cont-zapa figure-mediocampistas" style="background-image: url('{{ 'tipo-jugador-zapa02.png' | asset_url }}');"></figure>
					<figure class="cont-zapa selected figure-delanteros" style="background-image: url('{{ 'tipo-jugador-zapa04.png' | asset_url }}');"></figure>
				</div>
			</div>
		</div>
	</div>	
</section>

{% schema %}
{
	"name": "Tipos de jugador",
	"settings": [],
	"presets": [
		{
			"name": "Tipos de jugador home"
		}
	]

}
{% endschema %}